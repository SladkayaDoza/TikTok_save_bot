# Скопируй в .env и заполни:  cp .env.example .env
# Файл .env в .gitignore и в репозиторий не попадает.
#
# Обязательных полей всего два — токен и твой id. Всё остальное включает
# дополнительные функции: без ключей бот запускается и работает,
# а неготовые функции честно сообщают, что не настроены.

# =====================================================================
#  ОБЯЗАТЕЛЬНО
# =====================================================================

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой Telegram user id (узнать: @userinfobot).
# Только этот аккаунт может выполнять /setup, /embed_on, /embed_off, /embed_retry.
TELEGRAM_ADMIN_ID=123456789


# =====================================================================
#  КЛЮЧИ ПРОВАЙДЕРОВ — оба необязательны
# =====================================================================
# Одного ключа OpenRouter достаточно и для поиска, и для распознавания речи.

# Семантический поиск (/find, /similar) + распознавание речи.
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Только распознавание речи (команда `meow`). Нужен, если не хочешь
# заводить OpenRouter. Ключ: https://deepinfra.com/dash/api_keys
#DEEPINFRA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# =====================================================================
#  РАСПОЗНАВАНИЕ РЕЧИ — необязательно, показаны значения по умолчанию
# =====================================================================

# Кто распознаёт речь (команда `meow` и обогащение видео для поиска):
#   auto        — DeepInfra, если есть её ключ, иначе OpenRouter, иначе выключено.
#                 Порядок такой, чтобы обновление ничего не меняло само собой.
#   openrouter  — только OpenRouter (удобно: один ключ на всё)
#   deepinfra   — только DeepInfra
#   off         — распознавание выключено полностью
#TRANSCRIBE_PROVIDER=auto

#ASR_MODEL=openai/whisper-large-v3
#ASR_LANGUAGE=ru


# =====================================================================
#  СЕМАНТИЧЕСКИЙ ПОИСК — необязательно, показаны значения по умолчанию
# =====================================================================

# --- Модели (актуальные слаги: https://openrouter.ai/models) ---
#EMBED_MODEL=google/gemini-embedding-2
#VLM_MODEL=google/gemini-3.5-flash-lite

# Размерность вектора, 128..3072. Модель обучена по Матрёшке, поэтому
# вектор можно обрезать почти без потери качества.
# 768 -> 2000 роликов занимают ~6 МБ вместо ~25 МБ.
# ВНИМАНИЕ: после смены нужно переиндексировать — старые векторы несовместимы.
#EMBED_DIM=768

# --- Когда звать VLM (описание кадров) — главный рычаг стоимости ---
#   always    — всегда (по умолчанию). Описание кадров даёт больший прирост
#               точности поиска, чем любой другой шаг: без него recall@1
#               падает примерно на 15 п.п.
#   no_speech — только когда речи нет или транскрипт пустой. Экономит около
#               половины расхода ценой заметной части точности.
#   never     — никогда: дешевле всего, но ролики без речи попадают
#               в индекс практически пустыми и не находятся.
#VLM_POLICY=always

# Сколько кадров отдавать VLM
#VLM_FRAMES=4

# Лимит токенов ответа VLM. 300 не хватало на карточку из шести полей,
# и описания обрывались на полуслове.
#VLM_MAX_TOKENS=2000

# Просить модель не возвращать размышления (у некоторых моделей reasoning
# обязателен и молча съедает лимит токенов). 0 — не отправлять поле вовсе.
#VLM_REASONING=1

# --- Деньги ---
# Месячный лимит в долларах. При исчерпании обогащение встаёт, а видео
# продолжают качаться и отправляться как обычно; админу приходит уведомление.
# Очередь не теряется. 0 = без лимита.
#EMBED_MONTHLY_LIMIT_USD=5.0

# --- Автоподсказка «похоже на это» при отправке нового видео ---
# 1.0 = выключена полностью (значение по умолчанию).
# Понизь до ~0.85, чтобы бот сам подписывал ссылку на похожий ролик.
#EMBED_SIMILAR_THRESHOLD=1.0

# --- Прочее ---
# Минимальный скор, ниже которого результат не показывается в /find.
# Подобран замером: 0.20 отсекает часть заведомого мусора ценой 0.3%
# правильных ответов. Честного «ничего не найдено» на этой шкале не бывает —
# классы правильных и мусорных ответов перекрываются.
# ВАЖНО: значение привязано к шкале ПОСЛЕ центрирования векторов.
#EMBED_FIND_MIN_SCORE=0.20

# Потолок папки embed_queue/ в мегабайтах. При превышении новые видео
# в очередь не ставятся (защита от переполнения диска).
#EMBED_MAX_QUEUE_MB=2000
